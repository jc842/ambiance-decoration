---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.lang || data.lang === 'fr');
allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 7);
---

<Layout title="Ambiance Décoration — L'Art de Vivre Contemporain, Mobilier & Design d'Intérieur" description="Le carnet d'inspiration des passionnés de design et d'intérieurs raffinés : matières minérales, mobilier sculpté, scénographies de lumière et équilibre des volumes.">
  <!-- Hero Section Style Lexington Flabbergasted (Warm Terracotta / Soft Linen / Elegant Serif) -->
  <section class="relative bg-[#fcf9f5] text-stone-900 overflow-hidden border-b border-stone-200">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#b45309_0.8px,transparent_0.8px)] [background-size:20px_20px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-100/80 text-amber-900 border border-amber-200 mb-6">
            <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
            Magazine d'Architecture Intérieure & Mobilier Singulier
          </div>
          
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-stone-900 leading-tight font-serif">
            L'Élégance des Matières & le <span class="italic font-normal text-amber-800">Confort des Volumes</span>
          </h1>
          
          <p class="mt-6 text-lg sm:text-xl text-stone-600 max-w-2xl font-normal leading-relaxed">
            Plongez dans des intérieurs où le bois brut, les enduits à la chaux, le lin lavé et les scénographies lumineuses composent un havre de sérénité au quotidien.
          </p>

          <div class="mt-8 flex flex-wrap gap-4 items-center">
            <a href="#dossiers" class="px-6 py-3.5 rounded-xl bg-amber-800 hover:bg-amber-900 text-amber-50 font-bold text-sm tracking-wide transition-all shadow-md shadow-amber-900/10">
              Découvrir les Inspirations &darr;
            </a>
            <a href="/blog/" class="px-6 py-3.5 rounded-xl bg-white hover:bg-stone-50 text-stone-800 font-semibold text-sm border border-stone-300 transition-all">
              Explorer les 60 Chroniques &rarr;
            </a>
          </div>

          <!-- Flabbergasted Philosophy Bar -->
          <div class="mt-12 grid grid-cols-3 gap-6 pt-8 border-t border-stone-200">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-800 font-serif">Minéral</div>
              <div class="text-xs text-stone-500 mt-1">Chaux, Travertin & Lin</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-stone-900 font-serif">2700 K</div>
              <div class="text-xs text-stone-500 mt-1">Lumière Chaude Équilibrée</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-800 font-serif">Singulier</div>
              <div class="text-xs text-stone-500 mt-1">Pièces d'Édition & Métiers d'Art</div>
            </div>
          </div>
        </div>

        <!-- Featured Card -->
        {featuredPost && (
          <div class="lg:col-span-5">
            <div class="bg-white border border-stone-200 rounded-3xl p-6 sm:p-8 relative shadow-xl group hover:border-amber-800/40 transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                  Coup de Cœur Déco
                </span>
                <span class="text-xs text-stone-400 font-mono">
                  {new Date(featuredPost.data.pubDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-2xl font-bold text-stone-900 group-hover:text-amber-800 transition-colors leading-snug font-serif">
                <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
              </h2>
              {featuredPost.data.description && (
                <p class="mt-3 text-stone-600 text-sm line-clamp-3 leading-relaxed">
                  {featuredPost.data.description}
                </p>
              )}
              <div class="mt-6 pt-6 border-t border-stone-100 flex items-center justify-between">
                <span class="text-xs text-stone-400 font-medium">Thème: <strong class="text-stone-700">{featuredPost.data.category}</strong></span>
                <a href={`/blog/${featuredPost.id}/`} class="text-xs font-bold text-amber-800 group-hover:text-amber-950 flex items-center gap-1">
                  Lire l'article complet &rarr;
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Bento Grid Flabbergasted Section -->
  <section id="dossiers" class="py-20 bg-[#f7f3ed]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-amber-800 mb-2">Carnet Déco & Galeries</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-stone-900 font-serif">Intérieurs Remarquables & Inspirations</p>
        <p class="mt-3 text-base text-stone-600">Des idées pratiques pour composer des espaces harmonieux, lumineux et intemporels.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <article class="bg-white border border-stone-200 rounded-2xl p-6 hover:border-amber-700 transition-all flex flex-col justify-between group shadow-sm hover:shadow-lg">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-800">
                  {post.data.category || 'Décoration'}
                </span>
                <span class="text-xs text-stone-400">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                </span>
              </div>
              <h3 class="text-lg font-bold text-stone-900 group-hover:text-amber-800 transition-colors line-clamp-2 mb-2 font-serif">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              {post.data.description && (
                <p class="text-sm text-stone-600 line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>
            <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between">
              <span class="text-xs text-stone-400">Chronique vérifiée</span>
              <a href={`/blog/${post.id}/`} class="text-xs font-bold text-amber-800 group-hover:translate-x-1 transition-transform">
                Explorer &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-stone-900 text-stone-50 font-bold text-sm hover:bg-amber-800 transition-all shadow-md">
          Consulter les 60 Dossiers & Inspirations Déco &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- International Editions Callout -->
  <section class="py-12 border-t border-stone-200 bg-[#f2ede4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-4">International Editions / Ediciones Internacionales</p>
      <div class="flex justify-center items-center gap-6 text-sm font-semibold">
        <a href="/en/" class="text-amber-800 hover:underline flex items-center gap-1.5">
          <span>🇬🇧</span> English Edition (Interior Design Chronicles)
        </a>
        <span class="text-stone-300">|</span>
        <a href="/es/" class="text-amber-800 hover:underline flex items-center gap-1.5">
          <span>🇪🇸</span> Edición en Español (Crónicas de Decoración e Interiorismo)
        </a>
      </div>
    </div>
  </section>
</Layout>
