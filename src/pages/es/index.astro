---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.lang === 'es');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Ambiance Décoration — Revista de Interiorismo y Arte de Vivir (Edición en Español)" description="Inspiración editorial para un hogar contemporáneo: minimalismo cálido, iluminación escénica, tonos terrosos y diseño biofílico." lang="es">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-4">
        Edición en Español
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-stone-900 tracking-tight font-serif">
        Crónicas de Diseño e Interiorismo
      </h1>
      <p class="mt-4 text-lg text-stone-600">
        Ideas e inspiración para crear estancias serenas con materiales nobles, paletas minerales y mobiliario con carácter.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <span class="inline-block text-xs font-bold text-amber-800 uppercase tracking-wider mb-2">
              {post.data.category}
            </span>
            <h2 class="text-xl font-bold text-stone-900 mb-3 hover:text-amber-800 transition-colors font-serif">
              <a href={`/es/${post.id.replace(/^es\//, '')}/`}>{post.data.title}</a>
            </h2>
            <p class="text-stone-600 text-sm line-clamp-3 mb-4">
              {post.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
            <span class="text-xs text-stone-400">
              {new Date(post.data.pubDate).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <a href={`/es/${post.id.replace(/^es\//, '')}/`} class="text-sm font-semibold text-amber-800 hover:text-amber-950">
              Leer artículo &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
